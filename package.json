{
  "name": "mini.goeswhere.com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bundle:analyze": "tsc -b && vite build --mode analyze",
    "build:qalculate-wasm": "docker build --target wasm --output type=local,dest=src/assets qalculate-wasm",
    "ingest:units": "python3 scripts/ingest-qalculate-units.py",
    "deploy": "npm run build && rsync -av dist/ sek:/srv/mini.goeswhere.com/",
    "format": "oxfmt .",
    "lint": "oxfmt --check . && tsc -b",
    "test": "vitest run",
    "test:qalculate-bundle": "node --experimental-vm-modules qalculate-wasm/smoke-bundle.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.7.0",
    "@primer/octicons-react": "^19.38.0",
    "geo-tz": "^8.1.9",
    "preact": "^10.29.8",
    "suncalc": "^2.1.1",
    "sunrise-sunset-js": "^3.3.1",
    "temporal-polyfill": "^1.0.5",
    "three": "^0.186.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.72.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-preload": "^0.7.0",
    "vitest": "^5.0.3"
  }
}
